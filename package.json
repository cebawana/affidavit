  "bugs": {
    "url": "https://github.com/cebawana/affidavit/issues"
  },
  "keywords": [
    "qa",
    "testing",
    "e2e",
    "visual-testing",
    "playwright",
    "ai",
    "llm",
    "claude",
    "screenshots",
    "cli"
  ],
  "type": "module",
  "bin": {
    "affidavit": "bin/affidavit.mjs"
  },
  "files": [
