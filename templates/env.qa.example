# Copy to .env.qa.local (keep it out of git). Affidavit signs in through your
# app's login screen with these test accounts: dev/test accounts only, never
# real people's, never production.
# A spec's `role: admin` reads QA_ADMIN_EMAIL / QA_ADMIN_PASSWORD, and so on.
QA_ADMIN_EMAIL=
QA_ADMIN_PASSWORD=
QA_MEMBER_EMAIL=
QA_MEMBER_PASSWORD=

# Optional overrides
# QA_BASE_URL=http://localhost:3000
# QA_BACKEND=claude-cli          # claude-cli · openrouter
# QA_MODEL=sonnet
# QA_REVIEW_MODEL=
# QA_EXPLORE_MODEL=
# OPENROUTER_API_KEY=            # only for the openrouter backend
